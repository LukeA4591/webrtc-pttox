# Copy to `.env` and fill in your own hosts.
#
# Comma-separated list of bare PTToX signalling hosts — no scheme, no path.
# The first one is selected by default. The client builds the signalling URL
# itself as wss://<host>/api/webrtc/ws.
#
# Leave unset and the server list starts empty; add a host in the sidebar.
#
# Not a secret: Vite inlines VITE_* values into the built bundle at build time.
# This keeps internal hostnames out of the repository, nothing more.
VITE_PTTOX_SERVERS=pttox.example.test,another.example.test
